# nginx site config for relicsnrockets.io + dev.relicsnrockets.io
# Apply: sudo cp nginx.conf.example /etc/nginx/sites-available/empire1 && sudo nginx -t && sudo systemctl reload nginx
#
# Port mapping (Docker containers bind to 127.0.0.1):
#   Prod:  :8080 gameserver, :8000 webserver
#   Dev:   :8180 gameserver, :8100 webserver

# ── Prod: HTTP → HTTPS redirect ──────────────────────────────────────────────
server {
    listen 80;
    server_name relicsnrockets.io www.relicsnrockets.io;
    return 301 https://relicsnrockets.io$request_uri;
}

# ── Dev: HTTP only (no SSL) ───────────────────────────────────────────────────
server {
    listen 80;
    server_name dev.relicsnrockets.io;

    location /ws {
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location /metrics {
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /netdata/ {
        proxy_pass http://127.0.0.1:19999/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        auth_basic "Netdata";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }

    location ~ ^/api/(auth|empire|empires|army|attack|spy-attack|spy-reports|diplomacy|item|item-type|map|messages|push|admin|era-map|global-map|replays|battle-feedback|season-results)(/|$) {
        proxy_pass http://127.0.0.1:8180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# ── Dev: HTTPS fallback ───────────────────────────────────────────────────────
# Dev has no valid TLS cert of its own (HTTP-only by design — see block above).
# Without this block, any HTTPS request to dev.relicsnrockets.io (e.g. a
# browser auto-upgrading a typed http:// URL) falls through to whichever 443
# server block nginx treats as default (the first one below, prod's www
# redirect) and silently lands on PROD instead of dev. This block claims the
# hostname explicitly and bounces back down to the real http dev site instead.
# Reuses the prod cert only to complete the TLS handshake (hostname mismatch
# warning is expected and harmless since we redirect immediately).
server {
    listen 443 ssl;
    server_name dev.relicsnrockets.io;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    return 301 http://dev.relicsnrockets.io$request_uri;
}

# ── Prod: www → non-www redirect (HTTPS) ─────────────────────────────────────
server {
    listen 443 ssl;
    server_name www.relicsnrockets.io;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    return 301 https://relicsnrockets.io$request_uri;
}

# ── Prod ──────────────────────────────────────────────────────────────────────
server {
    listen 443 ssl;
    server_name relicsnrockets.io;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location /ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    location /metrics {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location /netdata/ {
        proxy_pass http://127.0.0.1:19999/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        auth_basic "Netdata";
        auth_basic_user_file /etc/nginx/.htpasswd;
    }

    location ~ ^/api/(auth|empire|empires|army|attack|spy-attack|spy-reports|diplomacy|item|item-type|map|messages|push|admin|era-map|global-map|replays|battle-feedback|season-results)(/|$) {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

